# Domaine servi par Traefik (obligatoire en prod)
LACTARIUM_HOST=lactarium.comeetjeanne.fr

# --- Google Sheets (optionnel) ---
# Si les 3 variables sont renseignées, Lactarium utilise Sheets.
# Sinon, fallback automatique sur un fichier JSON local (/data).
#
# 1. Créer un projet Google Cloud + activer Google Sheets API
# 2. Créer un compte de service, télécharger la clé JSON
# 3. Créer une Google Sheet, partager en Éditeur avec l'email du compte de service
# 4. Coller l'ID de la sheet (dans l'URL) et les credentials :

GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Coller la clé privée en une ligne, avec \n pour les retours à la ligne :
GOOGLE_PRIVATE_KEY=
