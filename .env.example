# Domaine servi par Traefik (obligatoire en prod)
LACTARIUM_HOST=lactae.app

# --- Supabase (obligatoire) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clé publishable (ou clé anon legacy — même usage)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias accepté si vous utilisez encore le nom "anon" :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (obligatoire pour l’envoi des push planifiés)
# Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID) ---
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact RFC8292 (mailto: ou https:)
VAPID_SUBJECT=mailto:hello@lactae.app

# Secret pour déclencher manuellement /api/cron/push et /api/cron/retention
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
